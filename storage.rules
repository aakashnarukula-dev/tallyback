rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedInWithPhone() {
      return request.auth != null
        && tokenPhone() is string
        && tokenPhone().size() > 0;
    }

    function tokenPhone() {
      return request.auth == null
        ? ''
        : request.auth.token.get(
            'phone_number',
            request.auth.token.get('verifiedPhone', '')
          );
    }

    function isEntryParticipant(entryId) {
      return signedInWithPhone()
        && firestore.exists(
          /databases/(default)/documents/ledgerEntries/$(entryId)
        )
        && (
          firestore.get(
            /databases/(default)/documents/ledgerEntries/$(entryId)
          ).data.lenderPhone == tokenPhone()
          || firestore.get(
            /databases/(default)/documents/ledgerEntries/$(entryId)
          ).data.borrowerPhone == tokenPhone()
        );
    }

    function mayDeleteUnsubmittedUpload(entryId, uploaderUid) {
      return request.auth != null
        && request.auth.uid == uploaderUid
        && (
          !firestore.exists(
            /databases/(default)/documents/ledgerEntries/$(entryId)
          )
          || firestore.get(
            /databases/(default)/documents/ledgerEntries/$(entryId)
          ).data.createdBy == request.auth.uid
        );
    }

    match /ledgerEntries/{entryId}/{uploaderUid}/{fileName} {
      // Upload ownership is tied to the authenticated Firebase UID. Phone
      // identity is enforced again when the ledger document is created.
      // Avoid rejecting a valid, freshly-created phone session while its ID
      // token is still missing the mirrored phone claim.
      allow create: if request.auth != null
        && request.auth.uid == uploaderUid
        && (
          !firestore.exists(
            /databases/(default)/documents/ledgerEntries/$(entryId)
          )
          || isEntryParticipant(entryId)
        )
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$')
        && request.resource.size > 0
        && request.resource.size <= 6 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
      allow read: if isEntryParticipant(entryId);
      // Borrower proof becomes immutable once attached to an existing due.
      // This prevents payment evidence disappearing after submission or review.
      allow delete: if mayDeleteUnsubmittedUpload(entryId, uploaderUid);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

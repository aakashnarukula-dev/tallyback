rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithPhone() {
      return request.auth != null
        && (
          hasTokenPhone()
          || hasStoredPhone()
        );
    }

    function hasTokenPhone() {
      return request.auth != null
        && request.auth.token.get('phone_number', '') is string
        && request.auth.token.get('phone_number', '').size() > 0;
    }

    function hasStoredPhone() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '') is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '').size() > 0;
    }

    function phone() {
      return hasStoredPhone()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone
        : request.auth.token.get('phone_number', '');
    }

    function isParticipant(data) {
      return signedInWithPhone()
        && data.participantPhones is list
        && data.participantPhones.hasAny([phone()]);
    }

    function validEntry(data) {
      return data.keys().hasAll([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt',
          'settledAt'
        ])
        && data.lender is map
        && data.borrower is map
        && data.lender.keys().hasOnly(['name', 'phone'])
        && data.borrower.keys().hasOnly(['name', 'phone'])
        && data.lender.name is string
        && data.borrower.name is string
        && data.lender.name.size() > 0
        && data.borrower.name.size() > 0
        && data.lenderPhone is string
        && data.borrowerPhone is string
        && data.lender.phone == data.lenderPhone
        && data.borrower.phone == data.borrowerPhone
        && data.lenderPhone != data.borrowerPhone
        && data.participantPhones is list
        && data.participantPhones.size() == 2
        && data.participantPhones.hasAll([data.lenderPhone, data.borrowerPhone])
        && data.amount is number
        && data.amount > 0
        && data.occasion is string
        && data.occasion.size() > 0
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.date is string
        && data.status in ['open', 'settled'];
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'phone', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.updatedAt == request.time;
    }

    function reviewEntry(data) {
      return get(/databases/$(database)/documents/ledgerEntries/$(data.entryId)).data;
    }

    function validReview(data) {
      return data.keys().hasAll([
          'entryId',
          'participantPhones',
          'lenderPhone',
          'borrowerPhone',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'note',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'entryId',
          'participantPhones',
          'lenderPhone',
          'borrowerPhone',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'note',
          'status',
          'createdAt',
          'updatedAt',
          'resolvedAt'
        ])
        && data.entryId is string
        && data.entryId.size() > 0
        && data.participantPhones is list
        && data.participantPhones.size() == 2
        && data.lenderPhone is string
        && data.borrowerPhone is string
        && data.participantPhones.hasAll([data.lenderPhone, data.borrowerPhone])
        && data.requestedByUid is string
        && data.requestedByPhone is string
        && data.kind in ['amount', 'paid']
        && data.proposedAmount is number
        && (
          (data.kind == 'amount' && data.proposedAmount > 0)
          || (data.kind == 'paid' && data.proposedAmount == 0)
        )
        && data.note is string
        && data.note.size() <= 280
        && data.status in ['pending', 'approved', 'rejected'];
    }

    function reviewMatchesEntry(data) {
      return exists(/databases/$(database)/documents/ledgerEntries/$(data.entryId))
        && reviewEntry(data).status == 'open'
        && data.lenderPhone == reviewEntry(data).lenderPhone
        && data.borrowerPhone == reviewEntry(data).borrowerPhone
        && data.participantPhones.hasAll([
          reviewEntry(data).lenderPhone,
          reviewEntry(data).borrowerPhone
        ]);
    }

    function approvedReviewApplied(data) {
      return data.status == 'rejected'
        || (
          data.status == 'approved'
          && (
            (
              data.kind == 'amount'
              && getAfter(/databases/$(database)/documents/ledgerEntries/$(data.entryId)).data.amount == data.proposedAmount
            )
            || (
              data.kind == 'paid'
              && getAfter(/databases/$(database)/documents/ledgerEntries/$(data.entryId)).data.status == 'settled'
            )
          )
        );
    }

    function ownsSplit(splitId) {
      return request.auth != null
        && get(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function ownsSplitAfterWrite(splitId) {
      return request.auth != null
        && getAfter(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function validSplit(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 280
        && data.active is bool
        && data.currency == 'INR'
        && data.ownerUid is string
        && data.ownerName is string
        && data.recipients is list
        && data.recipients.size() > 0
        && data.recipients.size() <= 50
        && data.totalAmount is number
        && data.totalAmount > 0;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if signedInWithPhone()
        && request.auth.uid == userId
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data);
      allow update: if signedInWithPhone()
        && request.auth.uid == userId
        && resource.data.phone == phone()
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);
      allow delete: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isParticipant(resource.data);
      allow create: if validEntry(request.resource.data)
        && isParticipant(request.resource.data)
        && request.resource.data.lenderPhone == phone()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isParticipant(resource.data)
        && isParticipant(request.resource.data)
        && validEntry(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.auth.uid == resource.data.createdBy
            &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'settledAt', 'updatedAt'])
            && resource.data.status == 'open'
            && request.resource.data.status == 'settled'
          )
          ||
          (
            request.auth.uid == resource.data.createdBy
            && resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lender',
                'borrower',
                'lenderPhone',
                'borrowerPhone',
                'participantPhones',
                'amount',
                'occasion',
                'method',
                'date',
                'updatedAt'
              ])
          )
        );
      allow delete: if false;
    }

    match /ledgerReviews/{reviewId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedInWithPhone()
        && validReview(request.resource.data)
        && reviewMatchesEntry(request.resource.data)
        && reviewEntry(request.resource.data).createdBy != request.auth.uid
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.requestedByPhone == phone()
        && request.resource.data.borrowerPhone == phone()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInWithPhone()
        && validReview(request.resource.data)
        && request.auth.uid == reviewEntry(resource.data).createdBy
        && phone() == resource.data.lenderPhone
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'updatedAt'])
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.updatedAt == request.time
        && approvedReviewApplied(request.resource.data);
      allow delete: if false;
    }

    match /splitPages/{splitId} {
      allow read: if resource.data.active == true
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read: if ownsSplit(splitId);
        allow create, update, delete: if ownsSplitAfterWrite(splitId);
      }

      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    match /truecallerAuth/{nonce} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}

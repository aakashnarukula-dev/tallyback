rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function tokenPhone() {
      return request.auth == null
        ? ''
        : request.auth.token.get(
            'phone_number',
            request.auth.token.get('verifiedPhone', '')
          );
    }

    function signedInWithPhone() {
      return request.auth != null
        && tokenPhone() is string
        && tokenPhone().size() > 0;
    }

    function phone() {
      return tokenPhone();
    }

    function isParticipant(data) {
      return signedInWithPhone()
        && (data.lenderPhone == phone() || data.borrowerPhone == phone());
    }

    function originalAmount(data) {
      return data.get('originalAmount', data.amount);
    }

    function paidAmount(data) {
      return data.get(
        'paidAmount',
        data.status in ['paid', 'settled'] ? originalAmount(data) : 0
      );
    }

    function remainingAmount(data) {
      return data.get(
        'remainingAmount',
        data.status in ['paid', 'settled']
          ? 0
          : originalAmount(data) - paidAmount(data)
      );
    }

    function expectedStatus(data) {
      return remainingAmount(data) == 0
        ? 'paid'
        : paidAmount(data) > 0 ? 'partially_paid' : 'open';
    }

    function sameMoney(left, right) {
      return left >= right - 0.000001 && left <= right + 0.000001;
    }

    function validMoneyAmount(value) {
      return value is number
        && value > 0
        && sameMoney(value * 100, int(value * 100 + 0.000001));
    }

    function validScreenshot(screenshot) {
      return screenshot is map
        && screenshot.keys().hasOnly(['path', 'name', 'contentType', 'size'])
        && screenshot.path is string
        && screenshot.path.matches(
          '^ledgerEntries/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9][A-Za-z0-9._-]{0,159}$'
        )
        && screenshot.name is string
        && screenshot.name.size() > 0
        && screenshot.name.size() <= 120
        && screenshot.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && screenshot.size is int
        && screenshot.size > 0
        && screenshot.size <= 6 * 1024 * 1024;
    }

    function validScreenshotList(screenshots, required) {
      return screenshots is list
        && screenshots.size() <= 5
        && (!required || screenshots.size() > 0)
        && (screenshots.size() < 1 || validScreenshot(screenshots[0]))
        && (screenshots.size() < 2 || validScreenshot(screenshots[1]))
        && (screenshots.size() < 3 || validScreenshot(screenshots[2]))
        && (screenshots.size() < 4 || validScreenshot(screenshots[3]))
        && (screenshots.size() < 5 || validScreenshot(screenshots[4]));
    }

    function validEntryScreenshots(data) {
      return !data.keys().hasAny(['screenshots'])
        || validScreenshotList(data.screenshots, true);
    }

    function validBalance(data) {
      return (
          !data.keys().hasAny(['originalAmount', 'paidAmount', 'remainingAmount'])
          && data.status in ['open', 'settled']
        )
        || (
          data.keys().hasAll(['originalAmount', 'paidAmount', 'remainingAmount'])
          && data.originalAmount is number
          && data.originalAmount == data.amount
          && validMoneyAmount(data.originalAmount)
          && data.paidAmount is number
          && data.paidAmount >= 0
          && data.paidAmount <= data.originalAmount
          && data.remainingAmount is number
          && data.remainingAmount == data.originalAmount - data.paidAmount
          && data.remainingAmount >= 0
          && (
            data.status == expectedStatus(data)
            || (data.status == 'settled' && data.remainingAmount == 0)
          )
        );
    }

    function validPendingReview(review, entry) {
      return review is map
        && review.keys().hasAll([
          'reviewId',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && review.keys().hasOnly([
          'reviewId',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && review.reviewId is string
        && review.reviewId.size() > 0
        && review.reviewId.size() <= 128
        && review.requestedByUid is string
        && review.requestedByPhone == entry.borrowerPhone
        && review.kind in ['amount', 'paid']
        && review.proposedAmount is number
        && review.proposedMethod in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && review.proposedOccasion is string
        && review.proposedOccasion.size() > 0
        && review.proposedOccasion.size() <= 80
        && review.proposedDate is string
        && review.proposedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          (review.kind == 'amount'
            && validMoneyAmount(review.proposedAmount)
            && review.proposedAmount >= paidAmount(entry))
          || (review.kind == 'paid' && review.proposedAmount == 0)
        )
        && review.note is string
        && review.note.size() <= 280
        && validScreenshotList(review.proofScreenshots, review.kind == 'paid')
        && review.status == 'pending'
        && review.createdAt is timestamp
        && review.updatedAt is timestamp
        && !entry.keys().hasAny(['pendingRepaymentId'])
        && entry.status in ['open', 'partially_paid'];
    }

    function validEntry(data) {
      return validEntryScreenshots(data)
        && validBalance(data)
        && data.keys().hasAll([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt',
          'settledAt',
          'lastRepaymentId',
          'pendingRepaymentId',
          'historyStarted',
          'review',
          'screenshots'
        ])
        && data.lender is map
        && data.borrower is map
        && data.lender.keys().hasOnly(['name', 'phone'])
        && data.borrower.keys().hasOnly(['name', 'phone'])
        && data.lender.name is string
        && data.borrower.name is string
        && data.lender.name.size() > 0
        && data.lender.name.size() <= 120
        && data.borrower.name.size() > 0
        && data.borrower.name.size() <= 120
        && data.lenderPhone is string
        && data.borrowerPhone is string
        && data.lender.phone == data.lenderPhone
        && data.borrower.phone == data.borrowerPhone
        && data.lenderPhone != data.borrowerPhone
        && data.participantPhones is list
        && data.participantPhones.size() == 2
        && data.participantPhones.hasAll([data.lenderPhone, data.borrowerPhone])
        && data.amount is number
        && validMoneyAmount(data.amount)
        && data.occasion is string
        && data.occasion.size() > 0
        && data.occasion.size() <= 80
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in ['open', 'partially_paid', 'paid', 'settled']
        && (!data.keys().hasAny(['historyStarted']) || data.historyStarted is bool)
        && (!data.keys().hasAny(['pendingRepaymentId']) || data.pendingRepaymentId is string)
        && (!data.keys().hasAny(['review']) || validPendingReview(data.review, data));
    }

    function validEntryEdit(before, after) {
      return after.diff(before).affectedKeys().hasOnly([
          'lender',
          'borrower',
          'amount',
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'occasion',
          'method',
          'date',
          'screenshots',
          'updatedAt'
        ])
        && before.status in ['open', 'partially_paid']
        && !before.keys().hasAny(['review'])
        && after.amount is number
        && validMoneyAmount(after.amount)
        && after.amount >= paidAmount(before)
        && after.originalAmount == after.amount
        && after.paidAmount == paidAmount(before)
        && after.remainingAmount == after.amount - paidAmount(before)
        && after.status == (
          after.remainingAmount == 0
            ? 'paid'
            : after.paidAmount > 0 ? 'partially_paid' : 'open'
        )
        && after.lender.phone == before.lender.phone
        && after.borrower.phone == before.borrower.phone
        && after.lender.name is string
        && after.lender.name.size() > 0
        && after.lender.name.size() <= 120
        && after.borrower.name is string
        && after.borrower.name.size() > 0
        && after.borrower.name.size() <= 120
        && after.occasion is string
        && after.occasion.size() > 0
        && after.occasion.size() <= 80
        && after.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && after.date is string
        && after.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validEntryScreenshots(after)
        && after.updatedAt == request.time;
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'phone', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.name.lower() != 'tallyback member'
        && data.name.lower() != 'my account'
        && data.phone is string
        && data.updatedAt == request.time;
    }

    function validContact(data, contactId) {
      return data.keys().hasAll(['name', 'phone', 'source', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'source', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.phone is string
        && contactId.matches('^[0-9]{10}$')
        && data.phone.matches('^[+]91[0-9]{10}$')
        && data.phone == '+91' + contactId
        && data.source in ['device', 'manual']
        && data.updatedAt == request.time;
    }

    function validReviewRecordCreate(reviewId, data) {
      let entry = getAfter(/databases/$(database)/documents/ledgerEntries/$(data.entryId)).data;
      return data.keys().hasAll([
          'entryId',
          'entryCreatedBy',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'originalAmount',
          'originalMethod',
          'originalOccasion',
          'originalDate',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'entryId',
          'entryCreatedBy',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'requestedByUid',
          'requestedByPhone',
          'resolvedByUid',
          'kind',
          'originalAmount',
          'originalMethod',
          'originalOccasion',
          'originalDate',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'resolvedAt',
          'updatedAt'
        ])
        && entry.keys().hasAny(['review'])
        && entry.review.reviewId == reviewId
        && data.entryCreatedBy == entry.createdBy
        && data.lender == entry.lender
        && data.borrower == entry.borrower
        && data.lenderPhone == entry.lenderPhone
        && data.borrowerPhone == entry.borrowerPhone
        && data.participantPhones == entry.participantPhones
        && data.requestedByUid == entry.review.requestedByUid
        && data.requestedByPhone == entry.review.requestedByPhone
        && data.kind == entry.review.kind
        && data.originalAmount == originalAmount(entry)
        && data.originalMethod == entry.method
        && data.originalOccasion == entry.occasion
        && data.originalDate == entry.date
        && data.proposedAmount == entry.review.proposedAmount
        && data.proposedMethod == entry.review.proposedMethod
        && data.proposedOccasion == entry.review.proposedOccasion
        && data.proposedDate == entry.review.proposedDate
        && data.note == entry.review.note
        && data.proofScreenshots == entry.review.proofScreenshots
        && data.status == 'pending'
        && !data.keys().hasAny(['resolvedByUid', 'resolvedAt'])
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function reviewRecordBecomes(reviewId, status) {
      let before = get(/databases/$(database)/documents/ledgerReviews/$(reviewId)).data;
      let after = getAfter(/databases/$(database)/documents/ledgerReviews/$(reviewId)).data;
      return before.status == 'pending'
        && after.status == status
        && after.resolvedByUid == request.auth.uid
        && after.resolvedAt == request.time
        && after.updatedAt == request.time;
    }

    function validCorrectionApproval(before, after) {
      let review = before.review;
      let nextRemaining = review.proposedAmount - paidAmount(before);
      return review.kind == 'amount'
        && reviewRecordBecomes(review.reviewId, 'approved')
        && after.amount == review.proposedAmount
        && after.originalAmount == review.proposedAmount
        && after.paidAmount == paidAmount(before)
        && after.remainingAmount == nextRemaining
        && after.status == (nextRemaining == 0 ? 'paid' : paidAmount(before) > 0 ? 'partially_paid' : 'open')
        && (nextRemaining != 0 || after.settledAt is string)
        && after.historyStarted == true
        && after.method == review.proposedMethod
        && after.occasion == review.proposedOccasion
        && after.date == review.proposedDate
        && after.diff(before).affectedKeys().hasOnly([
          'amount',
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'settledAt',
          'method',
          'occasion',
          'date',
          'review',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validPaidReviewApproval(before, after) {
      let review = before.review;
      return review.kind == 'paid'
        && reviewRecordBecomes(review.reviewId, 'approved')
        && after.amount == before.amount
        && after.originalAmount == originalAmount(before)
        && after.paidAmount == originalAmount(before)
        && after.remainingAmount == 0
        && after.status == 'paid'
        && after.settledAt is string
        && after.historyStarted == true
        && after.diff(before).affectedKeys().hasOnly([
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'settledAt',
          'review',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validReviewRejection(before, after) {
      return reviewRecordBecomes(before.review.reviewId, 'rejected')
        && after.historyStarted == true
        && after.diff(before).affectedKeys().hasOnly(['review', 'historyStarted', 'updatedAt']);
    }

    function validRepaymentRequestCreate(requestId, data) {
      let before = get(/databases/$(database)/documents/ledgerEntries/$(data.dueId)).data;
      let entry = getAfter(/databases/$(database)/documents/ledgerEntries/$(data.dueId)).data;
      return data.keys().hasAll([
          'dueId',
          'lenderId',
          'lenderPhone',
          'borrowerId',
          'borrowerPhone',
          'participantPhones',
          'payerName',
          'amount',
          'method',
          'paidAt',
          'proofScreenshots',
          'note',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'dueId',
          'lenderId',
          'lenderPhone',
          'borrowerId',
          'borrowerPhone',
          'participantPhones',
          'payerName',
          'amount',
          'method',
          'paidAt',
          'proofScreenshots',
          'note',
          'status',
          'createdAt',
          'reviewedAt',
          'reviewedBy'
        ])
        && entry.createdBy == data.lenderId
        && entry.lenderPhone == data.lenderPhone
        && entry.borrowerPhone == data.borrowerPhone
        && entry.participantPhones == data.participantPhones
        && entry.status in ['open', 'partially_paid']
        && !before.keys().hasAny(['pendingRepaymentId'])
        && entry.pendingRepaymentId == requestId
        && entry.historyStarted == true
        && data.borrowerId == request.auth.uid
        && data.borrowerPhone == phone()
        && data.payerName is string
        && data.payerName.size() > 0
        && data.payerName.size() <= 120
        && validMoneyAmount(data.amount)
        && data.amount <= remainingAmount(entry)
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.paidAt is string
        && data.paidAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validScreenshotList(data.proofScreenshots, true)
        && data.note is string
        && data.note.size() <= 280
        && data.status == 'pending'
        && !data.keys().hasAny(['reviewedAt', 'reviewedBy'])
        && data.createdAt == request.time;
    }

    function validLenderRecordedRepaymentCreate(requestId, data) {
      let before = get(/databases/$(database)/documents/ledgerEntries/$(data.dueId)).data;
      let after = getAfter(/databases/$(database)/documents/ledgerEntries/$(data.dueId)).data;
      return data.keys().hasAll([
          'dueId',
          'lenderId',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'payerName',
          'amount',
          'method',
          'paidAt',
          'proofScreenshots',
          'note',
          'status',
          'recordedBy',
          'createdAt',
          'reviewedAt',
          'reviewedBy'
        ])
        && data.keys().hasOnly([
          'dueId',
          'lenderId',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'payerName',
          'amount',
          'method',
          'paidAt',
          'proofScreenshots',
          'note',
          'status',
          'recordedBy',
          'createdAt',
          'reviewedAt',
          'reviewedBy'
        ])
        && before.createdBy == request.auth.uid
        && before.createdBy == data.lenderId
        && before.lenderPhone == phone()
        && before.lenderPhone == data.lenderPhone
        && before.borrowerPhone == data.borrowerPhone
        && before.participantPhones == data.participantPhones
        && before.status in ['open', 'partially_paid']
        && !before.keys().hasAny(['pendingRepaymentId'])
        && data.payerName == before.borrower.name
        && validMoneyAmount(data.amount)
        && data.amount <= remainingAmount(before)
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.paidAt is string
        && data.paidAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validScreenshotList(data.proofScreenshots, false)
        && data.note is string
        && data.note.size() <= 280
        && data.status == 'accepted'
        && data.recordedBy == 'lender'
        && data.reviewedBy == request.auth.uid
        && data.createdAt == request.time
        && data.reviewedAt == request.time
        && after.historyStarted == true
        && after.lastRepaymentId == requestId
        && sameMoney(after.paidAmount, paidAmount(before) + data.amount)
        && sameMoney(after.remainingAmount, remainingAmount(before) - data.amount);
    }

    function validAcceptedRepaymentEntry(entryId, before, after) {
      let requestId = after.lastRepaymentId;
      let repaymentBefore = get(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      let repaymentAfter = getAfter(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      let nextPaid = paidAmount(before) + repaymentAfter.amount;
      let nextRemaining = remainingAmount(before) - repaymentAfter.amount;
      return requestId is string
        && exists(/databases/$(database)/documents/repaymentRequests/$(requestId))
        && repaymentBefore.status == 'pending'
        && repaymentAfter.status == 'accepted'
        && repaymentAfter.dueId == entryId
        && repaymentAfter.lenderId == request.auth.uid
        && repaymentAfter.reviewedBy == request.auth.uid
        && repaymentAfter.reviewedAt == request.time
        && validMoneyAmount(repaymentAfter.amount)
        && repaymentAfter.amount <= remainingAmount(before)
        && (!before.keys().hasAny(['pendingRepaymentId']) || before.pendingRepaymentId == requestId)
        && !after.keys().hasAny(['pendingRepaymentId'])
        && after.historyStarted == true
        && after.amount == before.amount
        && after.originalAmount == originalAmount(before)
        && sameMoney(after.paidAmount, nextPaid)
        && sameMoney(after.remainingAmount, nextRemaining)
        && after.status == (nextRemaining == 0 ? 'paid' : 'partially_paid')
        && (nextRemaining != 0 || after.settledAt is string)
        && after.diff(before).affectedKeys().hasOnly([
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'settledAt',
          'lastRepaymentId',
          'pendingRepaymentId',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validLenderRecordedRepaymentEntry(entryId, before, after) {
      let requestId = after.lastRepaymentId;
      let repaymentAfter = getAfter(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      let nextPaid = paidAmount(before) + repaymentAfter.amount;
      let nextRemaining = remainingAmount(before) - repaymentAfter.amount;
      return requestId is string
        && !exists(/databases/$(database)/documents/repaymentRequests/$(requestId))
        && repaymentAfter.recordedBy == 'lender'
        && repaymentAfter.status == 'accepted'
        && repaymentAfter.dueId == entryId
        && repaymentAfter.lenderId == request.auth.uid
        && repaymentAfter.lenderPhone == phone()
        && repaymentAfter.reviewedBy == request.auth.uid
        && repaymentAfter.createdAt == request.time
        && repaymentAfter.reviewedAt == request.time
        && validMoneyAmount(repaymentAfter.amount)
        && repaymentAfter.amount <= remainingAmount(before)
        && after.amount == before.amount
        && after.originalAmount == originalAmount(before)
        && sameMoney(after.paidAmount, nextPaid)
        && sameMoney(after.remainingAmount, nextRemaining)
        && after.status == (nextRemaining == 0 ? 'paid' : 'partially_paid')
        && (nextRemaining != 0 || after.settledAt is string)
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'settledAt',
          'lastRepaymentId',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validPendingRepaymentEntry(entryId, before, after) {
      let requestId = after.pendingRepaymentId;
      let repaymentAfter = getAfter(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      return requestId is string
        && !before.keys().hasAny(['pendingRepaymentId'])
        && repaymentAfter.dueId == entryId
        && repaymentAfter.status == 'pending'
        && repaymentAfter.borrowerId == request.auth.uid
        && repaymentAfter.borrowerPhone == phone()
        && after.historyStarted == true
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'pendingRepaymentId',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validRejectedRepaymentEntry(entryId, before, after) {
      let requestId = before.get('pendingRepaymentId', '');
      let repaymentBefore = get(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      let repaymentAfter = getAfter(/databases/$(database)/documents/repaymentRequests/$(requestId)).data;
      return requestId is string
        && requestId.size() > 0
        && repaymentBefore.dueId == entryId
        && repaymentBefore.status == 'pending'
        && repaymentAfter.status == 'rejected'
        && repaymentAfter.reviewedBy == request.auth.uid
        && !after.keys().hasAny(['pendingRepaymentId'])
        && after.historyStarted == true
        && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly([
          'pendingRepaymentId',
          'historyStarted',
          'updatedAt'
        ]);
    }

    function validRepaymentResolution(requestId, before, after) {
      let entryBefore = get(/databases/$(database)/documents/ledgerEntries/$(before.dueId)).data;
      let entryAfter = getAfter(/databases/$(database)/documents/ledgerEntries/$(before.dueId)).data;
      return before.status == 'pending'
        && after.status in ['accepted', 'rejected']
        && after.diff(before).affectedKeys().hasOnly([
          'status',
          'reviewedAt',
          'reviewedBy'
        ])
        && after.reviewedBy == request.auth.uid
        && after.reviewedAt == request.time
        && entryAfter.historyStarted == true
        && (
          !entryBefore.keys().hasAny(['pendingRepaymentId'])
          || (
            entryBefore.pendingRepaymentId == requestId
            && !entryAfter.keys().hasAny(['pendingRepaymentId'])
          )
        )
        && (
          after.status == 'rejected'
          || (
            entryAfter.lastRepaymentId == requestId
            && sameMoney(entryAfter.paidAmount, paidAmount(
              get(/databases/$(database)/documents/ledgerEntries/$(before.dueId)).data
            ) + before.amount)
            && sameMoney(entryAfter.remainingAmount, remainingAmount(
              get(/databases/$(database)/documents/ledgerEntries/$(before.dueId)).data
            ) - before.amount)
          )
        );
    }

    function validActivity(data) {
      let entry = getAfter(/databases/$(database)/documents/ledgerEntries/$(data.dueId)).data;
      return data.keys().hasAll([
          'dueId',
          'sourceId',
          'type',
          'actorUid',
          'actorPhone',
          'actorName',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'eventDate',
          'method',
          'note',
          'status',
          'occurredAt'
        ])
        && data.keys().hasOnly([
          'dueId',
          'sourceId',
          'type',
          'actorUid',
          'actorPhone',
          'actorName',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'eventDate',
          'method',
          'note',
          'status',
          'occurredAt'
        ])
        && data.sourceId is string
        && data.sourceId.size() > 0
        && data.actorUid == request.auth.uid
        && data.actorPhone == phone()
        && data.actorName is string
        && data.actorName.size() > 0
        && data.actorName.size() <= 120
        && data.lender == entry.lender
        && data.borrower == entry.borrower
        && data.lenderPhone == entry.lenderPhone
        && data.borrowerPhone == entry.borrowerPhone
        && data.participantPhones == entry.participantPhones
        && data.amount is number
        && data.amount > 0
        && data.eventDate is string
        && data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.note is string
        && data.note.size() <= 280
        && data.status in ['open', 'partially_paid', 'paid', 'pending', 'accepted', 'rejected']
        && data.occurredAt == request.time
        && (
          (
            data.type in [
              'due_created',
              'due_edited',
              'repayment_accepted',
              'repayment_rejected',
              'payment_recorded',
              'correction_accepted',
              'correction_rejected',
              'due_marked_paid'
            ]
            && request.auth.uid == entry.createdBy
            && phone() == entry.lenderPhone
            && (
              data.actorName == entry.lender.name
              || data.actorName == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.name
            )
          )
          || (
            data.type in ['repayment_submitted', 'mistake_reported']
            && phone() == entry.borrowerPhone
            && (
              data.actorName == entry.borrower.name
              || data.actorName == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.name
            )
          )
        );
    }

    function ownsSplit(splitId) {
      return request.auth != null
        && get(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function ownsSplitAfterWrite(splitId) {
      return request.auth != null
        && getAfter(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function validSplit(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 280
        && data.active is bool
        && data.currency == 'INR'
        && data.ownerUid is string
        && data.ownerName is string
        && data.recipients is list
        && data.recipients.size() > 0
        && data.recipients.size() <= 50
        && data.totalAmount is number
        && data.totalAmount > 0;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if signedInWithPhone()
        && request.auth.uid == userId
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data);
      allow update: if signedInWithPhone()
        && request.auth.uid == userId
        && resource.data.phone == phone()
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId}/contacts/{contactId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validContact(request.resource.data, contactId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isParticipant(resource.data);
      allow create: if validEntry(request.resource.data)
        && isParticipant(request.resource.data)
        && request.resource.data.keys().hasAll(['originalAmount', 'paidAmount', 'remainingAmount'])
        && request.resource.data.originalAmount == request.resource.data.amount
        && request.resource.data.paidAmount == 0
        && request.resource.data.remainingAmount == request.resource.data.originalAmount
        && request.resource.data.status == 'open'
        && request.resource.data.historyStarted == false
        && !request.resource.data.keys().hasAny(['review', 'settledAt', 'lastRepaymentId', 'pendingRepaymentId'])
        && request.resource.data.lenderPhone == phone()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isParticipant(resource.data)
        && phone() == resource.data.borrowerPhone
        && request.auth.uid != resource.data.createdBy
        && resource.data.status in ['open', 'partially_paid']
        && !resource.data.keys().hasAny(['review'])
        && request.resource.data.keys().hasAny(['review'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'historyStarted', 'updatedAt'])
        && validPendingReview(request.resource.data.review, resource.data)
        && !resource.data.keys().hasAny(['pendingRepaymentId'])
        && request.resource.data.historyStarted == true
        && request.resource.data.review.requestedByUid == request.auth.uid
        && request.resource.data.review.requestedByPhone == phone()
        && request.resource.data.review.createdAt == request.time
        && request.resource.data.review.updatedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isParticipant(resource.data)
        && request.auth.uid == resource.data.createdBy
        && phone() == resource.data.lenderPhone
        && resource.data.keys().hasAny(['review'])
        && !request.resource.data.keys().hasAny(['review'])
        && request.resource.data.updatedAt == request.time
        && (
          validCorrectionApproval(resource.data, request.resource.data)
          || validPaidReviewApproval(resource.data, request.resource.data)
          || validReviewRejection(resource.data, request.resource.data)
        );
      allow update: if isParticipant(resource.data)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRepaymentId'])
            && request.auth.uid == resource.data.createdBy
            && phone() == resource.data.lenderPhone
            && !resource.data.keys().hasAny(['review'])
            && request.resource.data.updatedAt == request.time
            && (
              validAcceptedRepaymentEntry(entryId, resource.data, request.resource.data)
              || validLenderRecordedRepaymentEntry(entryId, resource.data, request.resource.data)
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingRepaymentId'])
            && request.auth.uid != resource.data.createdBy
            && phone() == resource.data.borrowerPhone
            && validPendingRepaymentEntry(entryId, resource.data, request.resource.data)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingRepaymentId'])
            && request.auth.uid == resource.data.createdBy
            && phone() == resource.data.lenderPhone
            && validRejectedRepaymentEntry(entryId, resource.data, request.resource.data)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'historyStarted',
              'updatedAt'
            ])
            && request.auth.uid == resource.data.createdBy
            && phone() == resource.data.lenderPhone
            && request.resource.data.historyStarted == true
            && request.resource.data.updatedAt == request.time
          )
        );
      allow update: if isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lender', 'borrower', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (
          (
            phone() == resource.data.lenderPhone
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lender', 'updatedAt'])
            && request.resource.data.lender.keys().hasOnly(['name', 'phone'])
            && request.resource.data.lender.phone == resource.data.lender.phone
            && request.resource.data.lender.name == get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.name
          )
          || (
            phone() == resource.data.borrowerPhone
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['borrower', 'updatedAt'])
            && request.resource.data.borrower.keys().hasOnly(['name', 'phone'])
            && request.resource.data.borrower.phone == resource.data.borrower.phone
            && request.resource.data.borrower.name == get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.name
          )
        );
      allow update: if isParticipant(resource.data)
        && request.auth.uid == resource.data.createdBy
        && phone() == resource.data.lenderPhone
        && !resource.data.keys().hasAny(['review'])
        && !resource.data.keys().hasAny(['pendingRepaymentId'])
        && !request.resource.data.keys().hasAny(['review'])
        && request.resource.data.status != 'paid'
        && request.resource.data.get('lastRepaymentId', '') == resource.data.get('lastRepaymentId', '')
        && validEntryEdit(resource.data, request.resource.data);
      allow update: if isParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'originalAmount',
          'paidAmount',
          'remainingAmount',
          'status',
          'settledAt',
          'updatedAt'
        ])
        && request.auth.uid == resource.data.createdBy
        && phone() == resource.data.lenderPhone
        && !resource.data.keys().hasAny(['review'])
        && resource.data.status in ['open', 'partially_paid']
        && request.resource.data.originalAmount == originalAmount(resource.data)
        && request.resource.data.paidAmount == originalAmount(resource.data)
        && request.resource.data.remainingAmount == 0
        && request.resource.data.status == 'paid'
        && request.resource.data.settledAt is string
        && request.resource.data.updatedAt == request.time;
      allow delete: if isParticipant(resource.data)
        && request.auth.uid == resource.data.createdBy
        && resource.data.lenderPhone == phone()
        && resource.data.status == 'open'
        && paidAmount(resource.data) == 0
        && resource.data.get('historyStarted', false) == false
        && !resource.data.keys().hasAny(['review', 'lastRepaymentId', 'pendingRepaymentId'])
        && !entryId.matches('^split-.*');
    }

    match /ledgerReviews/{reviewId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedInWithPhone()
        && validReviewRecordCreate(reviewId, request.resource.data)
        && request.resource.data.borrowerPhone == phone()
        && request.resource.data.requestedByPhone == phone()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isParticipant(resource.data)
        && phone() == resource.data.lenderPhone
        && request.auth.uid == resource.data.entryCreatedBy
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'resolvedByUid',
          'resolvedAt',
          'updatedAt'
        ])
        && request.resource.data.resolvedByUid == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /repaymentRequests/{requestId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedInWithPhone()
        && (
          validRepaymentRequestCreate(requestId, request.resource.data)
          || validLenderRecordedRepaymentCreate(requestId, request.resource.data)
        );
      allow update: if isParticipant(resource.data)
        && phone() == resource.data.lenderPhone
        && request.auth.uid == resource.data.lenderId
        && validRepaymentResolution(requestId, resource.data, request.resource.data);
      allow delete: if false;
    }

    match /ledgerActivities/{activityId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedInWithPhone() && validActivity(request.resource.data);
      allow update, delete: if false;
    }

    match /splitPages/{splitId} {
      allow read: if resource.data.active == true
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read: if ownsSplit(splitId);
        allow create, update, delete: if ownsSplitAfterWrite(splitId);
      }

      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    match /truecallerAuth/{nonce} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithPhone() {
      return request.auth != null
        && tokenPhone() is string
        && tokenPhone().size() > 0;
    }

    function tokenPhone() {
      return request.auth == null
        ? ''
        : request.auth.token.get(
            'phone_number',
            request.auth.token.get('verifiedPhone', '')
          );
    }

    function phone() {
      return tokenPhone();
    }

    function isParticipant(data) {
      return signedInWithPhone()
        && (
          data.lenderPhone == phone()
          || data.borrowerPhone == phone()
        );
    }

    function validPendingReview(review, entry) {
      return review is map
        && review.keys().hasAll([
          'reviewId',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && review.keys().hasOnly([
          'reviewId',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && review.reviewId is string
        && review.reviewId.size() > 0
        && review.reviewId.size() <= 128
        && review.requestedByUid is string
        && review.requestedByPhone is string
        && review.requestedByPhone == entry.borrowerPhone
        && review.kind in ['amount', 'paid']
        && review.proposedAmount is number
        && review.proposedMethod in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && review.proposedOccasion is string
        && review.proposedOccasion.size() > 0
        && review.proposedOccasion.size() <= 80
        && review.proposedDate is string
        && review.proposedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          (review.kind == 'amount' && review.proposedAmount > 0)
          || (review.kind == 'paid' && review.proposedAmount == 0)
        )
        && review.note is string
        && review.note.size() <= 280
        && review.proofScreenshots is list
        && review.proofScreenshots.size() <= 5
        && (review.kind != 'paid' || review.proofScreenshots.size() > 0)
        && review.status == 'pending'
        && review.createdAt is timestamp
        && review.updatedAt is timestamp
        && entry.status == 'open';
    }

    function validScreenshot(screenshot) {
      return screenshot is map
        && screenshot.keys().hasOnly(['path', 'name', 'contentType', 'size'])
        && screenshot.path is string
        && screenshot.path.matches(
          '^ledgerEntries/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9][A-Za-z0-9._-]{0,159}$'
        )
        && screenshot.name is string
        && screenshot.name.size() > 0
        && screenshot.name.size() <= 120
        && screenshot.contentType is string
        && screenshot.size is int
        && screenshot.size > 0;
    }

    function validScreenshots(data) {
      return !data.keys().hasAny(['screenshots'])
        || (
          data.screenshots is list
          && data.screenshots.size() > 0
          && data.screenshots.size() <= 5
          && validScreenshot(data.screenshots[0])
          && (data.screenshots.size() < 2
            || validScreenshot(data.screenshots[1]))
          && (data.screenshots.size() < 3
            || validScreenshot(data.screenshots[2]))
          && (data.screenshots.size() < 4
            || validScreenshot(data.screenshots[3]))
          && (data.screenshots.size() < 5
            || validScreenshot(data.screenshots[4]))
        );
    }

    function validReviewRecordCreate(reviewId, data) {
      let entry = getAfter(/databases/$(database)/documents/ledgerEntries/$(data.entryId)).data;
      return data.keys().hasAll([
          'entryId',
          'entryCreatedBy',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'requestedByUid',
          'requestedByPhone',
          'kind',
          'originalAmount',
          'originalMethod',
          'originalOccasion',
          'originalDate',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'entryId',
          'entryCreatedBy',
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'requestedByUid',
          'requestedByPhone',
          'resolvedByUid',
          'kind',
          'originalAmount',
          'originalMethod',
          'originalOccasion',
          'originalDate',
          'proposedAmount',
          'proposedMethod',
          'proposedOccasion',
          'proposedDate',
          'note',
          'proofScreenshots',
          'status',
          'createdAt',
          'resolvedAt',
          'updatedAt'
        ])
        && entry.keys().hasAny(['review'])
        && entry.review.reviewId == reviewId
        && data.entryCreatedBy == entry.createdBy
        && data.lender == entry.lender
        && data.borrower == entry.borrower
        && data.lenderPhone == entry.lenderPhone
        && data.borrowerPhone == entry.borrowerPhone
        && data.participantPhones == entry.participantPhones
        && data.requestedByUid == entry.review.requestedByUid
        && data.requestedByPhone == entry.review.requestedByPhone
        && data.kind == entry.review.kind
        && data.originalAmount == entry.amount
        && data.originalMethod == entry.method
        && data.originalOccasion == entry.occasion
        && data.originalDate == entry.date
        && data.proposedAmount == entry.review.proposedAmount
        && data.proposedMethod == entry.review.proposedMethod
        && data.proposedOccasion == entry.review.proposedOccasion
        && data.proposedDate == entry.review.proposedDate
        && data.note == entry.review.note
        && data.proofScreenshots == entry.review.proofScreenshots
        && data.status == 'pending'
        && !data.keys().hasAny(['resolvedByUid', 'resolvedAt'])
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validEntry(data) {
      return validScreenshots(data)
        && data.keys().hasAll([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'lender',
          'borrower',
          'lenderPhone',
          'borrowerPhone',
          'participantPhones',
          'amount',
          'occasion',
          'method',
          'date',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt',
          'settledAt',
          'review',
          'screenshots'
        ])
        && data.lender is map
        && data.borrower is map
        && data.lender.keys().hasOnly(['name', 'phone'])
        && data.borrower.keys().hasOnly(['name', 'phone'])
        && data.lender.name is string
        && data.borrower.name is string
        && data.lender.name.size() > 0
        && data.borrower.name.size() > 0
        && data.lenderPhone is string
        && data.borrowerPhone is string
        && data.lender.phone == data.lenderPhone
        && data.borrower.phone == data.borrowerPhone
        && data.lenderPhone != data.borrowerPhone
        && data.participantPhones is list
        && data.participantPhones.size() == 2
        && data.participantPhones.hasAll([data.lenderPhone, data.borrowerPhone])
        && data.amount is number
        && data.amount > 0
        && data.occasion is string
        && data.occasion.size() > 0
        && data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
        && data.date is string
        && data.status in ['open', 'settled']
        && (
          !data.keys().hasAny(['review'])
          || validPendingReview(data.review, data)
        );
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'phone', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.phone is string
        && data.updatedAt == request.time;
    }

    function validContact(data, contactId) {
      return data.keys().hasAll(['name', 'phone', 'source', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'source', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.phone is string
        && contactId.matches('^[0-9]{10}$')
        && data.phone.matches('^[+]91[0-9]{10}$')
        && data.phone == '+91' + contactId
        && data.source in ['device', 'manual']
        && data.updatedAt == request.time;
    }

    function ownsSplit(splitId) {
      return request.auth != null
        && get(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function ownsSplitAfterWrite(splitId) {
      return request.auth != null
        && getAfter(/databases/$(database)/documents/splitPages/$(splitId)).data.ownerUid == request.auth.uid;
    }

    function validSplit(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'active',
          'currency',
          'ownerUid',
          'ownerName',
          'recipients',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 280
        && data.active is bool
        && data.currency == 'INR'
        && data.ownerUid is string
        && data.ownerName is string
        && data.recipients is list
        && data.recipients.size() > 0
        && data.recipients.size() <= 50
        && data.totalAmount is number
        && data.totalAmount > 0;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if signedInWithPhone()
        && request.auth.uid == userId
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data);
      allow update: if signedInWithPhone()
        && request.auth.uid == userId
        && resource.data.phone == phone()
        && request.resource.data.phone == phone()
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId}/contacts/{contactId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validContact(request.resource.data, contactId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isParticipant(resource.data);
      allow delete: if isParticipant(resource.data)
        && request.auth.uid == resource.data.createdBy
        && resource.data.lenderPhone == phone()
        && !entryId.matches('^split-.*');
      allow create: if validEntry(request.resource.data)
        && isParticipant(request.resource.data)
        && !request.resource.data.keys().hasAny(['review'])
        && request.resource.data.lenderPhone == phone()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // The targeted review branches run before the full-schema lender branch,
      // keeping atomic review/audit writes below Firestore's expression limit.
      allow update: if (
          isParticipant(resource.data)
          && phone() == resource.data.borrowerPhone
          && request.auth.uid != resource.data.createdBy
          && resource.data.status == 'open'
          && !resource.data.keys().hasAny(['review'])
          && request.resource.data.keys().hasAny(['review'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['review', 'updatedAt'])
          && validPendingReview(request.resource.data.review, resource.data)
          && request.resource.data.review.requestedByUid == request.auth.uid
          && request.resource.data.review.requestedByPhone == phone()
          && request.resource.data.review.createdAt == request.time
          && request.resource.data.review.updatedAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          isParticipant(resource.data)
          && request.auth.uid == resource.data.createdBy
          && resource.data.status == 'open'
          && resource.data.keys().hasAny(['review'])
          && !request.resource.data.keys().hasAny(['review'])
          && request.resource.data.updatedAt == request.time
          && (
            (
              resource.data.review.kind == 'amount'
              && request.resource.data.status == 'open'
              && request.resource.data.amount == resource.data.review.proposedAmount
              && request.resource.data.method == resource.data.review.proposedMethod
              && request.resource.data.occasion == resource.data.review.proposedOccasion
              && request.resource.data.date == resource.data.review.proposedDate
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['amount', 'method', 'occasion', 'date', 'review', 'updatedAt'])
            )
            ||
            (
              resource.data.review.kind == 'paid'
              && request.resource.data.status == 'settled'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'settledAt', 'review', 'updatedAt'])
            )
            ||
            (
              request.resource.data.status == 'open'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['review', 'updatedAt'])
            )
          )
        )
        || (
          isParticipant(resource.data)
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
          (
            !resource.data.keys().hasAny(['review'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'settledAt', 'updatedAt'])
            && resource.data.status == 'open'
            && request.resource.data.status == 'settled'
          )
          ||
          (
            resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'amount',
                'occasion',
                'method',
                'date',
                'screenshots',
                'updatedAt'
              ])
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.occasion is string
            && request.resource.data.occasion.size() > 0
            && request.resource.data.occasion.size() <= 80
            && request.resource.data.method in ['UPI', 'Credit card', 'Cash', 'Bank transfer', 'Personal funds']
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && validScreenshots(request.resource.data)
          )
        ));
      allow delete: if false;
    }

    match /ledgerReviews/{reviewId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedInWithPhone()
        && validReviewRecordCreate(reviewId, request.resource.data)
        && request.resource.data.borrowerPhone == phone()
        && request.resource.data.requestedByPhone == phone()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isParticipant(resource.data)
        && phone() == resource.data.lenderPhone
        && request.auth.uid == resource.data.entryCreatedBy
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedByUid', 'resolvedAt', 'updatedAt'])
        && request.resource.data.resolvedByUid == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /splitPages/{splitId} {
      allow read: if resource.data.active == true
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validSplit(request.resource.data);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read: if ownsSplit(splitId);
        allow create, update, delete: if ownsSplitAfterWrite(splitId);
      }

      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    match /truecallerAuth/{nonce} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
